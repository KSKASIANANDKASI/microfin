{
  "name": "microfin-lms",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-platform Local Microfinance Loan Management System",
  "workspaces": [
    "packages/shared",
    "packages/theme",
    "packages/i18n",
    "packages/db",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build:shared": "npm run build -w @lms/shared",
    "dev:api": "npm run dev -w @lms/api",
    "dev:web": "npm run dev -w @lms/web",
    "dev:mobile": "npm --prefix apps/mobile start",
    "db:generate": "npm run generate -w @lms/db",
    "db:migrate": "npm run migrate -w @lms/db",
    "db:seed": "npm run seed -w @lms/db",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:web": "npm run build -w @lms/web",
    "typecheck:mobile": "npm --prefix apps/mobile run typecheck",
    "install:mobile": "npm --prefix apps/mobile install",
    "dev:mobile:web": "npm --prefix apps/mobile run web"
  },
  "engines": {
    "node": ">=20"
  }
}
