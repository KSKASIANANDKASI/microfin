{
  "expo": {
    "name": "Finance Easy",
    "slug": "billionbrains-lms",
    "scheme": "billionbrains",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F8FB",
    "primaryColor": "#062045",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ltd.billionbrains.lms"
    },
    "android": {
      "package": "ltd.billionbrains.lms",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#062045"
      }
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Finance Easy needs your photo library to attach an existing scan of the customer’s ID.",
          "cameraPermission": "Finance Easy uses the camera to photograph the customer’s ID proof."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Finance Easy uses your location to pin a customer’s doorstep when you onboard them."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-screen-orientation",
      "expo-font",
      "expo-status-bar"
    ]
  }
}
