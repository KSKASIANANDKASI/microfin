# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://lms:lms@localhost:5432/lms?schema=public"

# ---- API ----
PORT=4000
JWT_SECRET="change-me-in-production"
JWT_ACCESS_TTL="8h"
MOBILE_JWT_TTL="30d"
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# When true the OTP is returned in the API response instead of being sent by SMS (dev only).
OTP_DEV_ECHO=true
SMS_PROVIDER="console"   # console | msg91 | twilio
SMS_API_KEY=""
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS="http://localhost:5173,http://localhost:8081"

# ---- AI analytics assistant (Claude) ----
# Server-side only; never expose it to the web or mobile bundle.
ANTHROPIC_API_KEY=""

# ---- Web (Vite) ----
VITE_API_URL="http://localhost:4000"
# Optional: Google Maps JavaScript API key. With it the collection route shows a pin per customer;
# without it the route falls back to the keyless Google Maps directions embed.
VITE_GOOGLE_MAPS_API_KEY=""

# ---- Mobile (Expo) ----
EXPO_PUBLIC_API_URL="http://10.0.2.2:4000"
