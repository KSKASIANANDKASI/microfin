# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://lms:lms@localhost:5432/lms?schema=public"

# ---- Spring Boot API (apps/api-spring) ----
# JDBC form of the database above. See apps/api-spring/README.md for every variable.
DB_URL="jdbc:postgresql://localhost:5432/lms"
DB_USERNAME="lms"
DB_PASSWORD="lms"
# Base64 AES key that encrypts customer ID numbers at rest: `openssl rand -base64 32`.
# Changing it makes stored ID numbers unreadable.
KYC_ENCRYPTION_KEY=""
# Where uploaded KYC photos are kept.
LMS_STORAGE_DIR="./data/uploads"

# ---- API ----
PORT=4000
JWT_SECRET="change-me-in-production"
JWT_ACCESS_TTL="8h"
MOBILE_JWT_TTL="30d"
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# When true the OTP is returned in the API response instead of being sent by SMS (dev only).
OTP_DEV_ECHO=true
SMS_PROVIDER="console"   # console | msg91 | twilio
SMS_API_KEY=""
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS="http://localhost:5173,http://localhost:8081"

# ---- AI analytics assistant (Claude) ----
# Server-side only; never expose it to the web or mobile bundle.
ANTHROPIC_API_KEY=""

# ---- Email (Spring API, SMTP) ----
# Password reset links. Leave MAIL_HOST blank to send nothing (the API only logs).
# Port 587 = STARTTLS. For port 465 set MAIL_SSL=true and MAIL_STARTTLS=false.
MAIL_HOST=""
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_STARTTLS=true
MAIL_SSL=false
MAIL_SMTP_AUTH=true
# Most providers only accept a sender address they have verified.
MAIL_FROM="Finance Easy <no-reply@example.com>"
# The web app's reset page; the emailed link appends ?token=…
MAIL_RESET_URL="http://localhost:5173/reset-password"

# ---- Web (Vite) ----
VITE_API_URL="http://localhost:4000"
# Optional: Google Maps JavaScript API key. With it the collection route shows a pin per customer;
# without it the route falls back to the keyless Google Maps directions embed.
# Enable "Geocoding API" on it too for the place search above the doorstep pin map.
VITE_GOOGLE_MAPS_API_KEY=""

# ---- Mobile (Expo) ----
EXPO_PUBLIC_API_URL="http://10.0.2.2:4000"
# Optional: Google Maps key for the doorstep pin map on Android (enable "Maps SDK for Android",
# restrict it to the app's package + signing SHA-1). Read when the native app is built, so rebuild
# after changing it. iOS uses Apple Maps and needs no key. Put it in apps/mobile/.env.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=""
